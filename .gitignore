# Build output
/build/
/build-desktop/
# host build configured with -DLUR_AGENT=ON (compile-checks the gated paths)
/build-agent/
# ad-hoc optimized host build dir
/build-opt/
**/build/
**/build-agent/
**/.cxx/

# Desktop Workbench local save dir (Phase 0.5)
.lur-desktop-save/
*.o
*.obj
*.a
*.lib
*.so
*.dylib

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Android (generic: covers Games/Chess and Games/RocksPapersScissors alike)
**/.gradle/
**/.kotlin/
**/local.properties
**/*.iml
Games/Chess/Android/captures/
Games/Chess/Android/app/release/
Games/RocksPapersScissors/Android/captures/
Games/RocksPapersScissors/Android/app/release/
.idea/

# Xcode / iOS
Games/Chess/iOS/build/
Games/Chess/iOS/DerivedData/
*.xcuserstate
xcuserdata/

# OS noise
.DS_Store
Thumbs.db

# Transient build logs from scripts/
scripts/*.log

# Device log captures. `ios.txt` is the filename CLAUDE.md's iOS recipe writes to
# (`pymobiledevice3 syslog live -pn <proc> -o ios.txt`), so it reappears at the repo root every
# time anyone debugs the iPhone — unanchored, since the capture lands wherever the shell is.
# It is a throwaway snapshot of one session, never evidence anyone should read from the tree.
ios.txt

# Downloaded build artifacts (e.g. the sideloadable .ipa).
# ANCHORED and UNANCHORED both, on purpose: `/dist/` alone let a 1.8 MB .ipa be committed at
# Games/Chess/Android/dist/ on 2026-08-12, because `gh run download -D dist` inherited a shell
# cwd left behind by a `cd … /Android && ./gradlew` a few commands earlier. The download lands
# wherever the shell happens to be, so the ignore has to hold wherever that is.
/dist/
dist/
# Belt and braces: no signed/unsigned app package belongs in the tree at all, least of all an
# AGENT build (LUR_AGENT artifacts must never sit next to a player one — see CLAUDE.md).
*.ipa
*.apk
*.aab

# Offline cook tools downloaded on demand (e.g. msdf-atlas-gen by scripts/gen-font.ps1)
# — NOT committed; sanctioned build-time tools, never linked into the app. (Was /tools/,
# renamed to avoid colliding with the committed Tools/ dir on case-insensitive Windows.)
/.cache/

# Tools/ dev-utility build outputs (source is committed; built binaries are not).
Tools/**/*.exe
Tools/**/*.obj
Tools/**/*.pdb

# BLE dev-rig captured logs + pulled flight recorder (issue #58).
Tools/BleDevRig/.logs/

# DeviceRig captured logs, screenshots, markers.
Tools/DeviceRig/.logs/

# Python bytecode caches
__pycache__/
*.pyc
rps-cvars.cfg

# Local MoltenVK checkout (the one sanctioned runtime dependency; fetched, not vendored)
/MoltenVK/
/MoltenVK

# Scratch: screenshots pulled off a device, and stray tool temp files. These have been
# swept into a commit by a wide `git add` before — the ignore is the guard.
scratch_*.png
*.tmp
