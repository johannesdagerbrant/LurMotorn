<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app shell manifest, shared by every game (#198).

     There was one of these per game and they differed by ZERO lines once the names were
     normalized — only the activity class, the native library name and a comment naming the .so.
     All three are now placeholders that each app supplies once in its build.gradle.kts, beside
     its application id, so this file is genuinely identical for every game rather than
     accidentally so.

     ${libName}  the native library android_main lives in  (also read by LurActivity)
     ${logTag}   what `logcat -s <tag>` filters on          (read by LurActivity) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE is the cross-platform transport (see CLAUDE.md). Android 12+ split the
         old BLUETOOTH/BLUETOOTH_ADMIN perms into these runtime permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- API 26-30: the pre-Android-12 Bluetooth model. BLUETOOTH/BLUETOOTH_ADMIN are
         install-time; scanning for BLE devices additionally required location. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="true" />

    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:allowBackup="false">

        <!-- Control passes to C++ (android_main in lib${libName}.so). The Kotlin subclass exists
             only so the BLE shim object is constructed and reachable from native code over JNI;
             it is the engine's, shared by every game. -->
        <activity
            android:name="com.lurmotorn.shell.LurActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density">
            <meta-data android:name="android.app.lib_name" android:value="${libName}" />
            <!-- Read by LurActivity: the tag every line this app logs is filed under. -->
            <meta-data android:name="com.lurmotorn.log_tag" android:value="${logTag}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
